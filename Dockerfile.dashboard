FROM python:3.12-slim

ARG BUILD_SHA=""
LABEL org.opencontainers.image.revision=$BUILD_SHA

WORKDIR /app

ENV BUILD_SHA=$BUILD_SHA

COPY requirements-dashboard.txt requirements-runtime.txt ./
RUN pip install --no-cache-dir -r requirements-dashboard.txt

COPY . .
RUN mkdir -p logs

EXPOSE 8501

CMD ["streamlit", "run", "dashboard/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true", "--browser.gatherUsageStats=false"]
