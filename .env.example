# Kalshi Weather Engine example configuration

# Account
ACCOUNT_SIZE=5000

# Kalshi credentials
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/run/secrets/kalshi_private_key.pem

# Lane controls
# Maintenance default: keep the live weather lane off until explicitly re-enabled.
FORECAST_LANE_ACTIVE=false
FORECAST_AUTONOMOUS_ENABLED=false
SHADOW_EXECUTION=false
# Versioned NYC live-risk posture (config.py NYC_LIVE_POLICY_REVISION).
KALSHI_MAX_DEPLOYED_PCT=0.90
KALSHI_MAX_ENTRY_SLIPPAGE=0.02
KALSHI_POSITION_SNAPSHOT_MAX_AGE_SEC=60
KALSHI_MIN_MODEL_HEADROOM_F=2.0
KALSHI_MAX_CONCURRENT_POSITIONS=20
KALSHI_SAME_EVENT_FAMILY_CAP=5
KALSHI_HUB_EXPOSURE_PCT=0.40
KALSHI_HUB_EXPOSURE_MIN_USD=20
KALSHI_MAX_QTY_PER_POSITION=15
KALSHI_MAX_USD_PER_POSITION=10.0
KALSHI_MIN_ENTRY_PRICE=0.34
KALSHI_KELLY_CAP=0.12
KALSHI_KELLY_FRACTION=0.25
KALSHI_MAX_RISK_PER_EVENT_PCT=0.08
KALSHI_HIGH_PROB_THRESHOLD=0.80
KALSHI_ULTRA_HIGH_PROB_THRESHOLD=0.90
KALSHI_HIGH_PROB_POSITION_CAP_MULTIPLIER=1.50
KALSHI_ULTRA_HIGH_PROB_POSITION_CAP_MULTIPLIER=2.00
KALSHI_ULTRA_HIGH_PROB_NO_CONCURRENT_BONUS=2
KALSHI_ULTRA_HIGH_PROB_NO_FAMILY_CAP_BONUS=1
KALSHI_TAKER_FEE_RATE=0.07
SALVAGE_EXIT_DELTA=0.15
SALVAGE_EXIT_DELTA_HIGH_PROB=0.12
SALVAGE_EXIT_DELTA_ULTRA_HIGH_PROB=0.10

# Optional AI/oracle backend
REASONING_PROVIDER=gemini
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_MODE=enabled

# Production uses keyless deterministic GFS/ECMWF/AIGFS plus HRRR and METAR.
# Commercial Open-Meteo ensembles are intentionally not part of this release.

# RBI 2.0 must observe at least seven days of official, current-epoch forecast
# evidence before it may create or promote a learned challenger. Bump the epoch
# whenever the production probability contract changes materially.
RBI_MIN_DAYS=7
RBI_MIN_NEW_CLEAN_TRADES=24
RBI_LEARNING_EPOCH=v19.20.0-deterministic-physics-path

# Telegram operator channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO

# Weather provider cadence / backpressure
WEATHER_ACTIVE_CITY_REFRESH_SEC=300
WEATHER_PROVIDER_COOLDOWN_SEC=1200
WEATHER_MODEL_PAUSE_SEC=0.75
KALSHI_HOURLY_EXIT_INVALIDATION_HOURS=1.50
KALSHI_HOURLY_EXIT_REDEPLOY_HOURS=0.75
KALSHI_HOURLY_EXIT_BID_FLOOR=0.05
KALSHI_HOURLY_EXIT_REDEPLOY_EDGE=0.00

# Optional: move writable runtime state off the repo or onto an external volume
# ALGO_RUNTIME_DIR=/Volumes/ExternalSSD/kalshi-runtime
# DB_PATH=trades.db
# BOT_LOG_PATH=bot.log
# FORECAST_LOG_PATH=forecast.log
# MIN_FREE_DISK_MB=2048

# Versioned NYC city firewall (2026-08-24): only CHI, DEN, LAX, OKC, and SAT
# remain enabled among the 32 known stations. An explicit empty value disables
# the source fallback and trades every city; use that only as an intentional override.
CITY_BLACKLIST=ABQ,ATL,AUS,BOS,CHS,CLT,DAL,DC,DET,HOU,LV,MCI,MCO,MIA,MKE,MSP,MSY,NY,OMA,PDX,PHL,PHX,RDU,SEA,SF,SLC,STL
